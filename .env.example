# SEO Machine Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit your .env file with real credentials!

# ============================================
# Vercel Web Analytics Configuration
# ============================================
# Traffic data comes from CSVs you export manually from the Vercel dashboard.
# By default the loader looks at the repo root. Override here if needed.
# VERCEL_ANALYTICS_DIR=./analytics

# ============================================
# Google Search Console Configuration
# ============================================
# Your website URL as it appears in Search Console
# Include https:// and trailing slash
GSC_SITE_URL=https://yoursite.com/

# Path to your GSC service account JSON credentials file
GSC_CREDENTIALS_PATH=./credentials/gsc-credentials.json

# ============================================
# DataForSEO API Configuration
# ============================================
# Your DataForSEO login email
DATAFORSEO_LOGIN=your_email@example.com

# Your DataForSEO API password
DATAFORSEO_PASSWORD=your_api_password_here

# ============================================
# Optional: Blog Path Filter
# ============================================
# If your blog is not at /blog/, change this to match your URL structure
# Examples: /articles/, /content/, /resources/
BLOG_PATH=/blog/

# ============================================
# Optional: Company Information
# ============================================
# These are optional and can help with context
COMPANY_NAME=Your Company Name
COMPANY_DOMAIN=yoursite.com
TARGET_INDUSTRY=your-industry

# ============================================
# Setup Instructions
# ============================================
#
# 1. Vercel Web Analytics:
#    - Open your project in the Vercel dashboard
#    - Analytics → Pages → Export CSV (do this for 24h, 7d, 30d, 90d windows)
#    - Analytics → Referrers → Export CSV (90d)
#    - Drop the files at the repo root (or wherever VERCEL_ANALYTICS_DIR points)
#    - Keep Vercel's default filenames — the loader parses dates from them
#
# 2. Google Search Console:
#    - Go to Google Cloud Console (console.cloud.google.com)
#    - Create a service account, enable Google Search Console API
#    - Add the service account email as a user in Search Console
#    - Save JSON credentials to ./credentials/gsc-credentials.json
#
# 3. DataForSEO:
#    - Sign up at dataforseo.com
#    - Get API credentials from dashboard
#    - Add login and password here
#
# 4. Copy this file:
#    cp .env.example data_sources/config/.env
#
# For detailed setup instructions, see data-sources-setup.md

# ============================================
# SE Ranking API Configuration
# ============================================
# Data API key from seranking.com → API section
# Powers rankings snapshots, keyword research, backlinks, site audits, AI visibility
SERANKING_API_KEY=your_seranking_api_key
